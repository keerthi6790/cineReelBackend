datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MERCHANT
  CUSTOMER
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  name                 String
  password             String
  role                 Role      @default(MERCHANT)
  emailVerified        Boolean   @default(false)
  verificationToken    String?
  verificationTokenExp DateTime?
  stores               Store[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Store {
  id              String    @id @default(uuid())
  name            String
  slug            String    @unique
  logo            String?
  favicon         String?
  description     String?
  contactEmail    String?
  contactPhone    String?
  
  // Business address fields
  addressStreet   String?
  addressCity     String?
  addressState    String?
  addressZip      String?
  addressCountry  String?   @default("United States")
  
  // Social media links
  socialFacebook  String?
  socialInstagram String?
  socialTwitter   String?
  socialLinkedin  String?
  socialYoutube   String?
  socialTiktok    String?
  socialPinterest String?

  // Domain & Custom domain
  customDomain    String?
  domainStatus    String?   @default("PENDING")

  // Regional & Localization settings
  currency        String    @default("USD")
  language        String    @default("en-US")
  timezone        String    @default("UTC")

  // Active Template & Theme Configuration
  activeTemplateSlug   String?   @default("nova-tech")
  
  // Theme Color Scheme
  themePrimaryColor    String?   @default("#3B82F6")
  themeSecondaryColor  String?   @default("#64748B")
  themeBackgroundColor String?   @default("#FFFFFF")
  themeTextColor       String?   @default("#0F172A")
  themeAccentColor     String?   @default("#EC4899")

  // Theme Typography
  themeHeadingFont     String?   @default("Inter")
  themeBodyFont        String?   @default("Inter")
  themeFontSize        String?   @default("md")

  // Theme Visuals & Layout
  themeBorderRadius    String?   @default("md")
  themeButtonStyle     String?   @default("solid")
  themeLayoutWidth     String?   @default("standard")

  // Header Configuration
  headerStyle          String?   @default("left-aligned")
  headerSticky         Boolean?  @default(true)
  headerAnnouncement   String?   @default("🚀 Free shipping on orders over $50!")
  headerShowSearch     Boolean?  @default(true)
  headerShowCurrency   Boolean?  @default(true)

  // Footer Configuration
  footerStyle          String?   @default("multi-column")
  footerCopyright      String?   @default("© 2026 OmniStore. All rights reserved.")
  footerShowSocial     Boolean?  @default(true)
  footerShowNewsletter Boolean?  @default(true)
  footerShowPaymentBadges Boolean? @default(true)

  status          String    @default("ACTIVE")
  ownerId         String
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  templateId      String?
  template        Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String?  @default("📦")
  description String?
  stores      Store[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Template {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  tagline      String?
  description  String?
  previewImage String?
  accentColor  String   @default("#3B82F6")
  badge        String?
  features     String?
  stores       Store[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Page {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  content         String
  pageType        String   @default("CUSTOM")
  metaTitle       String?
  metaDescription String?
  status          String   @default("PUBLISHED")
  storeId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Product {
  id              String   @id @default(uuid())
  name            String
  description     String?
  images          String?
  sku             String?  @unique
  price           Float
  compareAtPrice  Float?
  costPrice       Float?
  taxRate         Float?   @default(0.0)
  taxable         Boolean  @default(true)
  inventory       Int      @default(0)
  weight          Float?
  dimensions      String?
  variantsJson    String?
  sizeOptions     String?
  colorOptions    String?
  material        String?
  tags            String?
  brandName       String?
  categoryName    String?
  collectionName  String?
  metaTitle       String?
  metaDescription String?
  status          String   @default("ACTIVE")
  storeId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  logo        String?
  description String?
  website     String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Collection {
  id               String   @id @default(uuid())
  name             String   @unique
  slug             String   @unique
  image            String?
  description      String?
  type             String   @default("MANUAL")
  rulesJson        String?
  ruleMatch        String?  @default("ALL")
  manualProductIds String?
  featured         Boolean  @default(false)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductReview {
  id          String   @id @default(uuid())
  productId   String
  userName    String
  userEmail   String?
  rating      Int      @default(5)
  title       String?
  comment     String
  verified    Boolean  @default(true)
  status      String   @default("APPROVED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Menu {
  id        String   @id @default(uuid())
  title     String
  handle    String   @unique
  location  String   @default("HEADER")
  itemsJson String?
  storeId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                  String   @id @default(uuid())
  orderNumber         String   @unique
  customerName        String
  customerEmail       String
  customerPhone       String?
  totalAmount         Float
  subtotalAmount      Float?
  taxAmount           Float?
  shippingAmount      Float?
  currency            String   @default("USD")
  paymentStatus       String   @default("PAID")
  fulfillmentStatus   String   @default("CONFIRMED")
  shippingAddressJson String?
  carrier             String?
  trackingNumber      String?
  cancellationReason  String?
  refundAmount        Float?
  refundReason        String?
  itemsJson           String?
  notesJson           String?
  storeId             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Customer {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  phone            String?
  group            String   @default("NEW")
  tags             String?
  addressJson      String?
  acceptsMarketing Boolean  @default(true)
  notesJson        String?
  totalOrders      Int      @default(0)
  totalSpent       Float    @default(0.0)
  storeId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Discount {
  id                  String    @id @default(uuid())
  title               String
  code                String?   @unique
  discountType        String    @default("PERCENTAGE")
  method              String    @default("COUPON_CODE")
  value               Float     @default(0.0)
  buyQuantity         Int?
  getQuantity         Int?
  getDiscountPercent  Float?
  minOrderAmount      Float?    @default(0.0)
  appliesTo           String    @default("ALL")
  targetIdsJson       String?
  customerEligibility String    @default("ALL")
  targetCustomerJson  String?
  usageLimit          Int?
  usageCount          Int       @default(0)
  oncePerCustomer     Boolean   @default(true)
  startDate           DateTime  @default(now())
  endDate             DateTime?
  status              String    @default("ACTIVE")
  storeId             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ShippingZone {
  id            String   @id @default(uuid())
  name          String
  countriesJson String
  ratesJson     String
  storeId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ShippingProvider {
  id          String   @id @default(uuid())
  name        String
  carrierCode String
  trackingUrl String
  isActive    Boolean  @default(true)
  apiKey      String?
  storeId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TaxRegion {
  id             String   @id @default(uuid())
  name           String
  country        String
  taxName        String   @default("GST")
  taxNumber      String?
  standardRate   Float    @default(18.0)
  reducedRate    Float?   @default(5.0)
  isTaxInclusive Boolean  @default(false)
  hsnSacJson     String?
  storeId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MarketingCampaign {
  id              String    @id @default(uuid())
  title           String
  channel         String    @default("EMAIL")
  status          String    @default("DRAFT")
  targetSegment   String    @default("ALL")
  subject         String?
  body            String?
  sentCount       Int       @default(0)
  clickCount      Int       @default(0)
  conversionCount Int       @default(0)
  revenueTotal    Float     @default(0.0)
  scheduledAt     DateTime?
  storeId         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model PixelConfig {
  id               String   @id @default(uuid())
  ga4MeasurementId String?
  metaPixelId      String?
  tikTokPixelId    String?
  pinterestTagId   String?
  storeId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}


